{
  "description": "Load craft at session start and remind the user when a newer release exists; never blocks the session.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check_skill_version.py\" --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
